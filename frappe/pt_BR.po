"\treqd: 1\n"
"},\n"
"{\n"
"\tfieldname: \"account\",\n"
"\tlabel: __(\"Account\"),\n"
"\tfieldtype: \"Link\",\n"
"\toptions: \"Account\",\n"
"\treqd: 1\n"
"}]\n"
"</code></pre>"
